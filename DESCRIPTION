Package: drillingdata
Title: Borehole Drilling and Construction Data – Malawi, 2018 - 2024
Version: 1.0.1
Authors@R: c(
    person("Emmanuel", "Mhango", , "emmanuellmhango@gmail.com", role = c("aut", "cre"),
